#!/usr/bin/env python3
"""
ffmpeg-color v2 — 词法分析驱动的 ffmpeg/ffprobe 输出着色器。

核心思路：先 tokenize（像编程语言 lexer 一样把一行拆成语义 token），
再 render（根据 token 类型映射颜色），绝不会出现「着色后再被正则误匹配」的问题。

用法:
    ffmpeg-color -i movie.mp4                       # 自动 ffprobe 模式
    ffmpeg-color -i in.mp4 -c:v libx264 out.mp4     # 自动 ffmpeg 模式
    ffprobe -show_streams f.mp4 | ffmpeg-color --pipe
    ffmpeg-color --help
"""

import sys, os, re, subprocess, signal, threading, queue

# ═══════════════════════════════════════════════════════════════════════════════
# Token 类型
# ═══════════════════════════════════════════════════════════════════════════════

class TT:
    """Token types — 每种代表一种语义单元。"""
    TEXT       = 'text'
    PUNCT      = 'punct'
    DIM        = 'dim'
    BOLD       = 'bold'
    # 结构
    TAG        = 'tag'           # [STREAM], [FORMAT]
    INPUT_HDR  = 'input_hdr'     # Input #0
    OUTPUT_HDR = 'output_hdr'    # Output #0
    SECTION    = 'section'       # Stream mapping:
    CONFIG     = 'config'        # configuration: ...
    FILENAME   = 'filename'
    FMT_NAME   = 'fmt_name'
    # 流信息
    STREAM_ID  = 'stream_id'     # Stream #0:0
    LANG       = 'lang'          # (und)
    VIDEO      = 'video'         # Video
    AUDIO      = 'audio'         # Audio
    SUBTITLE   = 'subtitle'      # Subtitle
    DATA       = 'data_stream'   # Data
    ATTACH     = 'attach_stream' # Attachment
    CODEC      = 'codec'         # h264, aac, ...
    PROFILE    = 'profile'       # (High 4:4:4 Predictive)
    CODEC_TAG  = 'codec_tag'     # (avc1 / 0x31637661)
    PIXFMT     = 'pixfmt'        # yuv420p
    SCAN       = 'scan'          # (progressive)
    RESOLUTION = 'resolution'    # 1920x1080
    ASPECT     = 'aspect'        # [SAR 1:1 DAR 16:9]
    BITRATE    = 'bitrate'       # 5000 kb/s
    FPS        = 'fps'           # 25 fps
    TBASE      = 'tbase'         # 25 tbr, 12800 tbn
    CHANS      = 'channels'      # mono, stereo, 5.1
    SRATE      = 'sample_rate'   # 44100 Hz
    SFMT       = 'sample_fmt'    # fltp, s16
    QUALITY    = 'quality'       # q=2-31
    FLAG       = 'flag'          # (default)
    # 键值对
    KEY        = 'key'           # codec_name
    KEY_HI     = 'key_hi'        # 重要 key（codec_name, width, ...）
    VALUE      = 'value'
    HEX        = 'hex'           # 0x31637661
    NUM        = 'num'           # 纯数字
    # 元数据
    MKEY       = 'mkey'          # handler_name:
    MVAL       = 'mval'          # VideoHandler
    # 进度
    PK         = 'prog_key'      # frame=
    PV         = 'prog_val'      # 25
    # 语义值
    TIME       = 'time'          # 00:00:01.00
    DURATION   = 'duration'
    # 状态
    ERROR      = 'error'
    WARNING    = 'warning'
    HINT       = 'hint'          # Press [q] to stop


# ═══════════════════════════════════════════════════════════════════════════════
# ANSI 颜色
# ═══════════════════════════════════════════════════════════════════════════════

class A:
    """ANSI 转义码常量。"""
    R   = '\033[0m'
    B   = '\033[1m'
    D   = '\033[2m'
    BLK = '\033[30m';  RED  = '\033[31m'; GRN = '\033[32m'; YEL = '\033[33m'
    BLU = '\033[34m';  MAG  = '\033[35m'; CYN = '\033[36m'; WHT = '\033[37m'
    GRY = '\033[90m';  LRED = '\033[91m'; LGRN= '\033[92m'; LYEL= '\033[93m'
    LBLU= '\033[94m';  LMAG = '\033[95m'; LCYN= '\033[96m'; LWHT= '\033[97m'


def _enable_vt():
    """Windows 10+ 启用虚拟终端。"""
    if sys.platform != 'win32':
        return
    try:
        import ctypes as ct
        k = ct.windll.kernel32
        for hid in (-11, -12):
            h = k.GetStdHandle(hid)
            if h:
                m = ct.c_ulong()
                k.GetConsoleMode(h, ct.byref(m))
                k.SetConsoleMode(h, m.value | 4)
    except Exception:
        pass


# ─── 颜色开关 ────────────────────────────────────────────────────────────────

_on = None

def _ok():
    global _on
    if _on is None:
        _on = (not os.environ.get('NO_COLOR')) and (
            bool(os.environ.get('FORCE_COLOR')) or
            os.environ.get('TERM') not in ('dumb', '', None) or
            sys.platform == 'win32'
        )
    return _on

def _a(text, *codes):
    """给 text 包裹 ANSI 前后缀。"""
    return (''.join(codes) + text + A.R) if _ok() and codes else text


