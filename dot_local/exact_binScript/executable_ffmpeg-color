def main():
    _enable_vt()
    args = sys.argv[1:]
    if not args or '--help' in args or '-h' in args:
        _help(); sys.exit(0)
    if '--version' in args or '-V' in args:
        print('ffmpeg-color v2.0.0'); sys.exit(0)
    
    mode = detect_mode(args)
    if mode == 'pipe':
        pipe_mode()
    else:
        run_wrapped(args, mode)


if __name__ == '__main__':
    main()
