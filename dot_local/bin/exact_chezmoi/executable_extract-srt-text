#!/usr/bin/gawk -f

BEGIN {
    RS = "\r?\n\r?\n+" # 段落模式：空行分隔记录 → 一个记录 = 一个字幕块 # 一个或多个 CRLF/LF 空行
    FS = "\n"          # 字段分隔符 = 换行 → 一行 = 一个字段
}
{
    # $1 = 序号, $2 = 时间轴, $3..$NF = 正文
    for (i = 3; i <= NF; i++) {
        sub(/\r$/, "", $i)     # 去掉行尾 CR（Windows 换行残留）
        if ($i != "") {
            print $i
        }
    }
}
