{{- $context := . -}}
{{- $preservePaths := list -}}
{{- if hasKey . "context" -}}
    {{- $context = get . "context" -}}
    {{- $preservePaths = get . "preservePaths" | default (list) -}}
{{- end -}}
{{- $stdin := get (get $context "chezmoi") "stdin" -}}
{{- if hasKey . "stdin" -}}
    {{- $stdin = get . "stdin" -}}
{{- end -}}

{{- /* 动态构造配置目录：当前文件所在目录 / 当前文件名.d */ -}}
{{- $templateDir := dir $context.chezmoi.sourceFile }}
{{- $targetBase := "" -}}
{{- if hasKey $context.chezmoi "targetFile" -}}
    {{- $targetBase = base $context.chezmoi.targetFile -}}
{{- else -}}
    {{- $targetBase = trimPrefix "modify_" (base $context.chezmoi.sourceFile) -}}
{{- end }}
{{- $subDir := print $targetBase ".d" }}
{{- $confDir := joinPath $context.chezmoi.sourceDir $templateDir $subDir }}

{{- /* 扫描所有 .json 和 .jsonc 文件 (递归) */ -}}
{{- $pattern := joinPath $confDir "**/*.json{,c}" }}
{{- $files := glob $pattern }}

{{- /* 合并 JSON */ -}}
{{- $merged := dict }}
{{- range $file := $files }}
    {{- $content := include $file | fromJsonc }}
    {{- $merged = mergeOverwrite $merged $content }}
{{- end }}

{{- /* 恢复调用方声明为外部管理的 JSON 路径 */ -}}
{{- if gt (len $preservePaths) 0 }}
    {{- $existing := dict -}}
    {{- if ne $stdin "" -}}
        {{- $existing = fromJsonc $stdin -}}
        {{- if not (kindIs "map" $existing) -}}
            {{- fail "merge-json-object: stdin must contain a JSON object" -}}
        {{- end -}}
    {{- end }}
    {{- range $path := $preservePaths }}
        {{- if eq (len $path) 0 }}
            {{- fail "merge-json-object: preservePaths entries must not be empty" }}
        {{- end }}

        {{- /* 首先删除合并的值 这样缺失的原始路径就不会出现 */ -}}
        {{- $parent := $merged -}}
        {{- $parentFound := true -}}
        {{- $lastIndex := sub (len $path) 1 -}}
        {{- range $index, $key := $path -}}
            {{- if eq $index $lastIndex -}}
                {{- if and $parentFound (kindIs "map" $parent) (hasKey $parent $key) -}}
                    {{- $_ := unset $parent $key -}}
                {{- end -}}
            {{- else if and $parentFound (kindIs "map" $parent) (hasKey $parent $key) (kindIs "map" (index $parent $key)) -}}
                {{- $parent = index $parent $key -}}
            {{- else -}}
                {{- $parentFound = false -}}
            {{- end -}}
        {{- end -}}

        {{- $value := $existing -}}
        {{- $found := true -}}
        {{- range $key := $path -}}
            {{- if and $found (kindIs "map" $value) (hasKey $value $key) -}}
                {{- $value = index $value $key -}}
            {{- else -}}
                {{- $found = false -}}
            {{- end -}}
        {{- end -}}
        {{- if $found }}
            {{- $merged = $merged | setValueAtPath $path $value }}
        {{- end }}
    {{- end }}
{{- end }}

{{- /* 输出漂亮的 JSON */ -}}
{{ $merged | toPrettyJson "    " }}
