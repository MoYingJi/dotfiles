{
    "servers": {
        "bash": {
            "highlightingModeRegex": "^Bash$",
            "servers": {
                "termux-language-server": {
                    "command": ["nvim-mason-path-exe", "termux-language-server"],
                    "rootIndicationFileNames": ["PKGBUILD"],
                    "priority": 1
